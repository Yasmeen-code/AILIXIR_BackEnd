# ==============================================================================
# AILIXIR Platform Environment Configuration
# Copy this file to .env (`cp .env.example .env`) and adjust values as needed.
# NOTE: Hugging Face Spaces (HF) values are active by default.
#       To switch to Docker Compose or Local mode, comment out the HF values
#       and uncomment the corresponding Docker/Local lines below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Settings
# ------------------------------------------------------------------------------

# The display name of the application used in emails, views, and logs
APP_NAME=AILIXIR

# The application execution environment (local, staging, production)
APP_ENV=production

# Encryption key used by Laravel for sessions, cookies, and hashes (32-byte base64 string).
# Leave empty to auto-generate on first container boot via entrypoint.sh, or run `php artisan key:generate`
APP_KEY=base64:CHANGEME_GENERATE_ON_FIRST_BOOT=

# Enables or disables detailed debug error pages (keep false in production)
APP_DEBUG=false

# Public base URL of the Laravel Backend API
# [Default: Hugging Face Spaces]
APP_URL=https://Ailixir-AI-Team-ailixir-api.hf.space
# [Alternative: Docker Compose / Local]
# APP_URL=http://localhost:8080

# Runtime execution mode read by docker/entrypoint.sh.
# When set to `hf`, entrypoint.sh starts supervisord to run both the web server (port 7860)
# and the queue worker inside a single container. Leave unset/commented for standard Docker Compose.
RUN_MODE=hf
# RUN_MODE=docker

# ------------------------------------------------------------------------------
# 2. Logging Configuration
# ------------------------------------------------------------------------------

# Where application logs are written (`stderr` outputs to container stdout/stderr for Docker & HF logs)
LOG_CHANNEL=stderr

# Minimum severity level for log messages (debug, info, notice, warning, error, critical)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. Database Configuration (SQLite)
# ------------------------------------------------------------------------------

# Database driver used by Laravel Eloquent and migrations
DB_CONNECTION=sqlite

# Absolute or relative path to the SQLite database file
# [Default: Container path used in Hugging Face Spaces & Docker]
DB_DATABASE=/var/www/html/database/ailixir.sqlite
# [Alternative: Local host development without Docker]
# DB_DATABASE=database/ailixir.sqlite

# ------------------------------------------------------------------------------
# 4. Session, Cache & Queue Drivers
# ------------------------------------------------------------------------------

# Storage driver for user sessions (`database` stores sessions in the SQLite `sessions` table)
SESSION_DRIVER=database

# Number of minutes a user session remains idle before expiring
SESSION_LIFETIME=120

# Storage backend for application cache entries (`database` uses the SQLite `cache` table)
CACHE_STORE=database

# Background job queue backend (`database` uses `jobs` table with queue:work; `sync` runs jobs inline)
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 5. AI Microservice Endpoints
# ------------------------------------------------------------------------------

# Enables `/api/ai-services/*` health-check and diagnostic proxy routes in Laravel
AI_INTEGRATION_ROUTES_ENABLED=true

# De Novo Molecular Generation & Docking Service (REINVENT4 + AutoDock-GPU)
# [Default: Hugging Face Spaces]
GENERATION_SERVICE_URL=https://shdwRow-ailixir-generation.hf.space
# [Alternative: Docker internal DNS]
# GENERATION_SERVICE_URL=http://generation:8000

# Chemical RAG Service (FAISS Binary Vector Search + LLM SAR Explanations)
# [Default: Hugging Face Spaces]
CHEMICAL_AI_URL=https://RottenShadow-ailixir-chemical-rag.hf.space
# [Alternative: Docker internal DNS]
# CHEMICAL_AI_URL=http://chemical-rag:5000

# ADMET 5-Task MPNN Prediction Service (Primary URL)
# [Default: Hugging Face Spaces]
ADMET_AI_URL=https://shdwRow-ailixir-admet.hf.space
# [Alternative: Docker internal DNS]
# ADMET_AI_URL=http://admet:8000

# ADMET 5-Task MPNN Prediction Service (Alias used by legacy/integration services)
# [Default: Hugging Face Spaces]
AI_ADMET_SERVICE_URL=https://shdwRow-ailixir-admet.hf.space
# [Alternative: Docker internal DNS]
# AI_ADMET_SERVICE_URL=http://admet:8000

# Drug Repurposing & Virtual Screening Service (DeepPurpose + OpenTargets/UniProt)
# [Default: Hugging Face Spaces]
DRUG_REPURPOSING_URL=https://RottenShadow-ailixir-drug-repurposing.hf.space
# [Alternative: Docker internal DNS]
# DRUG_REPURPOSING_URL=http://drug-repurposing:8000

# Drug Repurposing Service (Alias used by AI integration routes)
# [Default: Hugging Face Spaces]
AI_SERVICE_URL=https://RottenShadow-ailixir-drug-repurposing.hf.space
# [Alternative: Docker internal DNS]
# AI_SERVICE_URL=http://drug-repurposing:8000

# Conversational Chemistry Agent Service (Chat, SMILES analysis, CSV batch processing)
# [Default: Hugging Face Spaces]
CHEMISTRY_API_BASE_URL=https://shdwrow-ailixir-chat-bot.hf.space/

# Protein-Ligand Molecular Dynamics (GROMACS) Simulation Service URL
# [Default: Localhost / External tunnel]
MD_SIMULATION_URL=http://localhost:5005
# [Alternative: Docker internal DNS]
# MD_SIMULATION_URL=http://protein-ligand-md:5005

# ------------------------------------------------------------------------------
# 6. Cloudinary Storage Configuration
# ------------------------------------------------------------------------------

# Full Cloudinary connection URI (use dummy values if file upload to CDN is not required)
CLOUDINARY_URL=cloudinary://dummy_key:dummy_secret@dummy_cloud

# Cloudinary account cloud name
CLOUDINARY_CLOUD_NAME=dummy_cloud

# Cloudinary API public key
CLOUDINARY_API_KEY=dummy_key

# Cloudinary API secret key
CLOUDINARY_API_SECRET=dummy_secret

# ------------------------------------------------------------------------------
# 7. Mail Service Configuration (OTP Verification & Notifications)
# ------------------------------------------------------------------------------

# Mail transport driver (`smtp` sends real emails; use `log` to write emails to storage/logs instead)
MAIL_MAILER=smtp
# MAIL_MAILER=log

# SMTP server hostname
MAIL_HOST=smtp.gmail.com

# SMTP server port (587 for TLS/STARTTLS, 465 for SSL)
MAIL_PORT=587

# SMTP authentication username / email address
MAIL_USERNAME=YOUR_USERNAME

# SMTP authentication password or Google App Password
MAIL_PASSWORD=YOUR_PASSWORD

# Encryption protocol used for SMTP connection
MAIL_ENCRYPTION=tls

# Default sender email address shown on outgoing messages
MAIL_FROM_ADDRESS=YOUR_ADDRESS

# Default sender name shown on outgoing messages
MAIL_FROM_NAME="AILIXIR"

# ------------------------------------------------------------------------------
# 8. API Integration Test Suite Configuration
# ------------------------------------------------------------------------------

# Target API base URL used by external/automated API test scripts
BASE_URL=<APP_URL>/api

# Test user email address for automated endpoint testing
TEST_EMAIL=your_email@example.com

# Test user password for automated endpoint testing
TEST_PASSWORD=your_password

# Test user display name for automated registration/profile tests
TEST_NAME=Your Name
